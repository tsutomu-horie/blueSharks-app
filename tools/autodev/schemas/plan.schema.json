{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "scope", "steps", "validation", "risk", "rollback"],
  "properties": {
    "goal": {"type": "string", "maxLength": 1200},
    "scope": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 300}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
    "validation": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
    "risk": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 500}},
    "rollback": {"type": "string", "maxLength": 1200}
  }
}
