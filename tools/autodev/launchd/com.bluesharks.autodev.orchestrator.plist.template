<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bluesharks.autodev.orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>-m</string>
    <string>tools.autodev.cli</string>
    <string>run</string>
    <string>--continuous</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/work/Documents/Git/blueSharks-app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BLUE_SHARKS_AUTODEV_CONFIG</key>
    <string>/Users/work/.config/bluesharks-autodev/config.toml</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/local/opt/node/bin:/opt/homebrew/bin:/Applications/ChatGPT.app/Contents/Resources/codex-cli/codex-path:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/work/AgentWorkspace/logs/orchestrator.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/work/AgentWorkspace/logs/orchestrator.stderr.log</string>
</dict>
</plist>
